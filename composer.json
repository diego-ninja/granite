{
    "name": "diego-ninja/granite",
    "description": "A lightweight zero-dependency PHP library for building immutable, serializable objects with validation capabilities.",
    "keywords": [
        "immutable",
        "serializable",
        "objects",
        "php",
        "dto",
        "value-object",
        "data-transfer-object",
        "data-object",
        "data-structure",
        "auto-mapping",
        "auto-mapper",
        "data-mapper"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ninja\\Granite\\": "src/"
        },
        "files": [
            "functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Diego Rin",
            "email": "yosoy@diego.ninja"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "nesbot/carbon": "^3.10",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "ramsey/uuid": "^4.7",
        "symfony/uid": "^7.1"
    },
    "scripts": {
        "bench:objects": "@php -d opcache.enable_cli=1 benchmarks/ObjectPipelineBench.php",
        "test": "phpunit --no-coverage",
        "test:unit": "phpunit --testsuite=Unit --no-coverage",
        "test:integration": "phpunit --testsuite=Integration --no-coverage",
        "test:coverage": "phpunit --coverage-clover coverage/clover.xml --coverage-html coverage/html --coverage-text=coverage/coverage.txt",
        "test:coverage-clover": "phpunit --coverage-clover coverage/clover.xml",
        "test:support": "phpunit --testsuite=Support --no-coverage",
        "test:exceptions": "phpunit --testsuite=Exceptions --no-coverage",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check:aboutme": "php tools/check-aboutme.php",
        "check:coverage": "php tools/check-coverage.php coverage/clover.xml",
        "cs:check": "pint --test src tests",
        "cs:fix": "pint src tests"
    },
    "archive": {
        "exclude": [
            "/.DS_Store",
            "/.idea",
            "/.phpunit.cache",
            "/coverage",
            "/graphify-out",
            "/var",
            "/vendor"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
